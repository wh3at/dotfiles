{
  "lastChangelogVersion": "0.87.1",
  "theme": "dark",
  "tuiMode": "regular",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "defaultTools": ["+codemode"],
  "packages": [
    "git:github.com/nicobailon/pi-subagents@main",
    "npm:pi-web-access",
    "npm:pi-hashline-edit",
    "npm:pi-mcp-adapter",
    "git:github.com/championswimmer/pi-context-usage",
    "npm:pi-session-only-model",
    "npm:@wh3at_dev/pi-status-line",
    "npm:@ogulcancelik/pi-codex-compaction",
    "npm:pi-btw",
    "npm:pi-command-queue",
    "npm:@ff-labs/pi-fff",
    "npm:@wh3at_dev/pi-zen",
    "https://github.com/ayghri/i-have-adhd",
    "npm:pi-orca-dispatch"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 3000
  },
  "subagents": {
    "defaultModel": "opencode-go/deepseek-v4.1-flash:high",
    "agentOverrides": {
      "planner": {
        "model": "gpt-6-sol",
        "thinking": "xhigh"
      },
      "reviewer": {
        "model": "gpt-6.1-sol",
        "thinking": "high"
      },
      "oracle": {
        "model": "gpt-6-astra",
        "thinking": "high"
      }
    }
  },
  "collapseChangelog": true,
  "extensions": ["-builtin:mcp"]
}
