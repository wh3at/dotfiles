{
  "lastChangelogVersion": "0.84.4",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "low",
  "packages": [
    "git:github.com/nicobailon/pi-subagents@3e7f8f80f681705fffa0fd22e2c21c84093f61a1",
    "npm:pi-web-access",
    "npm:pi-hashline-edit",
