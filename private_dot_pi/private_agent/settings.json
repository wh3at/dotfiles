      "researcher": {
        "fallbackModels": [
          "gpt-5.6-luna:high"
        ]
      },
      "context-builder": {
        "fallbackModels": [
          "gpt-5.6-luna:high"
        ]
      },
      "delegate": {
        "fallbackModels": [
          "gpt-5.6-luna:xhigh"
        ]
      },
      "planner": {
        "model": "gpt-6-astra",
        "thinking": "medium"
      },
      "worker": {
        "fallbackModels": [
          "gpt-5.6-luna:xhigh"
        ]
      },
      "reviewer": {
        "model": "gpt-6-astra",
        "thinking": "medium"
      },
      "oracle": {
        "model": "gpt-6-astra",
        "thinking": "medium"
      }
    }
  },
  "collapseChangelog": true
