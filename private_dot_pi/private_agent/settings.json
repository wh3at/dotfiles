{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "tuiMode": "regular",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "defaultTools": [
    "+codemode"
  ],
  "packages": [
    "git:github.com/wh3at/pi-subagents",
    "npm:pi-web-access",
    "npm:pi-hashline-edit",
    "npm:pi-mcp-adapter",
    "git:github.com/championswimmer/pi-context-usage",
    "npm:pi-session-only-model",
    "npm:@wh3at_dev/pi-status-line",
    "npm:pi-btw",
    "npm:pi-command-queue",
    "npm:@ff-labs/pi-fff",
    "https://github.com/ayghri/i-have-adhd",
    "npm:pi-orca-dispatch",
    "npm:@wh3at_dev/pi-zen",
    "npm:pi-fast",
    "npm:pi-cached-compaction"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 3000
  },
  "subagents": {
    "defaultModel": "opencode-go/deepseek-v4.1-flash:high",
    "agentOverrides": {
      "scout": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "high"
      },
      "worker": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "low"
      },
      "planner": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "xhigh"
      },
      "reviewer": {
        "model": "gpt-6-astra",
        "thinking": "high"
      },
      "oracle": {
        "model": "gpt-6-astra",
        "thinking": "high"
      }
    }
  },
  "collapseChangelog": true,
  "deviceId": "fc30dc3f-ae20-449e-91e7-35dfd098a15f",
  "extensions": [
    "-builtin:mcp",
    "-builtin:codemode"
  ],
  "hideThinkingBlock": true
}